# Example Terraform variables
# Copy this to terraform.tfvars and fill in your values

location              = "East US"
resource_group_name   = "react-upload-rg"
app_name              = "react-upload"

# IMPORTANT: Must be globally unique and 3-24 lowercase alphanumeric characters
app_service_name      = "react-upload-app-CHANGEME"
storage_account_name  = "uploadstgCHANGEME"

# App Service Plan SKU: B1 (free tier), B2, B3, P1V2 (production)
app_service_sku       = "B1"

# CORS origin for the frontend (update with your frontend URL in production)
frontend_origin       = "http://localhost:5173"
